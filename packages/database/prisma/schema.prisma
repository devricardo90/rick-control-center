// Prisma schema for RICK Control Center
// Persistence foundation — sprint 0.
// NDERCC-5: first canonical domain slice — Project and IntegrationConnection.
//
// The NDERCC-4 `HealthCheck` proof-of-pipeline table is dropped by the
// NDERCC-5 migration (see prisma/migrations/*_initial_domain_model). The
// NDERCC-4 migration itself is left untouched — this is a new, additive
// migration, not an edit of migration history.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// RIC-006: initial, non-speculative project lifecycle. `archivedAt` carries
// the logical-archival timestamp; ARCHIVED mirrors it for direct filtering.
enum ProjectStatus {
  ACTIVE
  PAUSED
  ARCHIVED

  @@map("project_status")
}

// RIC-011 execution modes, reused as the project-level default policy.
enum AutonomyPolicy {
  SUPERVISED
  CONTROLLED_AUTONOMOUS

  @@map("autonomy_policy")
}

// The only two branch policies named in the Development Protocol
// (docs/12-development-protocol.md §7): dedicated branch per task (default),
// or direct commits where policy explicitly allows it.
enum BranchPolicy {
  BRANCH_PER_TASK
  DIRECT_COMMIT

  @@map("branch_policy")
}

// Required initial providers per NDERCC-5 scope.
enum IntegrationProvider {
  GITHUB
  JIRA
  GOOGLE_DRIVE
  AGENT_RUNTIME

  @@map("integration_provider")
}

// Verification lifecycle for an IntegrationConnection. PENDING until first
// verified; ERROR/DISCONNECTED are distinct so a failed check is
// distinguishable from a deliberate disconnect.
enum IntegrationConnectionStatus {
  PENDING
  CONNECTED
  ERROR
  DISCONNECTED

  @@map("integration_connection_status")
}

// RIC-006 / DEC-RIC-002: the only Google Drive-era provider authorized for
// NDERCC-12. Adding another document provider requires a later migration
// and a new decision.
enum DocumentProvider {
  GOOGLE_DRIVE

  @@map("document_provider")
}

// The approved strategic document classes (DEC-RIC-002). Not a free-form
// string: a fixed, reviewed enum keeps the registry queryable and prevents
// silent drift of what "counts" as a strategic document.
enum DocumentType {
  VISION
  PRD
  ARCHITECTURE
  ROADMAP
  DESIGN_SYSTEM
  DATA_MODEL
  STATE_MACHINE
  RISK_ENGINE
  MVP
  BACKLOG
  EXECUTION_CONTRACT_SPEC
  DEVELOPMENT_PROTOCOL

  @@map("document_type")
}

// Editorial/governance state — independent of synchronization state
// (DEC-RIC-002 invariant: approval and sync must never be conflated into
// one combined status).
enum DocumentApprovalStatus {
  DRAFT
  APPROVED
  REJECTED
  SUPERSEDED

  @@map("document_approval_status")
}

// Synchronization lifecycle with the external provider. PENDING until the
// first successful sync; STALE/ERROR are distinct so "known outdated" is
// distinguishable from "last sync attempt failed" — both preserve the last
// valid synchronized snapshot (revision/checksum/metadataJson/lastSyncedAt).
enum DocumentSyncStatus {
  PENDING
  SYNCED
  STALE
  ERROR

  @@map("document_sync_status")
}

// DEC-RIC-004 / NDERCC-16: deterministic strategic-truth projection.
enum RequirementType {
  FUNCTIONAL
  NON_FUNCTIONAL
  CONSTRAINT

  @@map("requirement_type")
}

enum RequirementPriority {
  P0
  P1
  P2
  P3
  UNSPECIFIED

  @@map("requirement_priority")
}

enum RequirementStatus {
  ACTIVE
  SUPERSEDED

  @@map("requirement_status")
}

enum DecisionStatus {
  PROPOSED
  APPROVED
  REJECTED
  SUPERSEDED

  @@map("decision_status")
}

// DEC-RIC-005 / NDERCC-17: operational backlog lifecycle. Sprint and Epic
// share the same four states and the same transition table, but stay
// separate enums so one can evolve later without silently redefining the
// other.
enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED

  @@map("sprint_status")
}

enum EpicStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED

  @@map("epic_status")
}

// READY, BLOCKED, AMBIGUOUS and CONFLICT are deliberately absent: they are
// resolver/diagnostic outcomes owned by P0-031/P0-032 and must be computed,
// never persisted (DEC-RIC-005 §5). Persisting them would let stored
// lifecycle state drift away from deterministic dependency evaluation.
enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED

  @@map("task_status")
}

// The RIC-006 initial task types, unchanged.
enum TaskType {
  STORY
  TASK
  BUG
  SPIKE
  CHORE

  @@map("task_type")
}

// P0 (highest) through P3. There is deliberately no UNSPECIFIED member —
// unlike RequirementPriority above, an operational Task must always carry an
// explicit, human-set priority, and priority is never inferred from wording,
// Jira order or creation time (DEC-RIC-005 §7).
enum TaskPriority {
  P0
  P1
  P2
  P3

  @@map("task_priority")
}

// Provenance only. JIRA is the single authorized member today; adding
// another provider requires a later migration and a new decision. This is
// separate from `IntegrationProvider` because that enum names connection
// targets, whereas this one names the origin of a backlog record.
enum BacklogExternalProvider {
  JIRA

  @@map("backlog_external_provider")
}

// NDERCC-23 / DEC-RIC-010: governed SDD specification lifecycle (P1-038).
//
// The same four-state vocabulary as `decision_status` and
// `document_approval_status`, kept a separate type so the specification
// lifecycle can evolve later without silently redefining either of them.
//
// There is deliberately no VALIDATED member. Validity is a pure function of
// specification content, recomputed on demand by @rick/domain; persisting a
// verdict would let it drift away from the content it describes — the same
// reasoning that keeps READY/BLOCKED/AMBIGUOUS/CONFLICT out of
// `task_status` (DEC-RIC-005 §5).
enum ImplementationSpecStatus {
  DRAFT
  APPROVED
  REJECTED
  SUPERSEDED

  @@map("implementation_spec_status")
}

// Root isolation aggregate. Every operational entity belongs to a Project.
model Project {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                 String    @unique
  name                String
  description         String?
  status              ProjectStatus  @default(ACTIVE)
  autonomyPolicy      AutonomyPolicy @default(CONTROLLED_AUTONOMOUS) @map("autonomy_policy")
  defaultBranchPolicy BranchPolicy   @default(BRANCH_PER_TASK) @map("default_branch_policy")
  workspacePath       String?   @map("workspace_path")
  createdAt           DateTime  @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3) @map("updated_at")
  archivedAt          DateTime? @db.Timestamptz(3) @map("archived_at")

  integrationConnections IntegrationConnection[]
  documentSources        DocumentSource[]
  documentSnapshots      DocumentSnapshot[]
  requirements           Requirement[]
  decisions              Decision[]
  sprints                Sprint[]
  epics                  Epic[]
  tasks                  Task[]
  taskDependencies       TaskDependency[]
  implementationSpecs    ImplementationSpec[]
  implementationSpecRequirements ImplementationSpecRequirement[]
  implementationSpecDecisions    ImplementationSpecDecision[]

  @@map("projects")
}

// First project-owned integration entity. `configurationEncrypted` is an
// opaque, already-encrypted payload — this package never encrypts, decrypts,
// or inspects it, and no plaintext credential field exists on this model.
model IntegrationConnection {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId               String    @map("project_id") @db.Uuid
  provider                IntegrationProvider
  displayName             String    @map("display_name")
  status                  IntegrationConnectionStatus @default(PENDING)
  externalAccountId       String?   @map("external_account_id")
  configurationEncrypted  String?   @map("configuration_encrypted")
  // Normalized, NON-SECRET provider metadata only (e.g. GitHub
  // owner/name/default branch/visibility) — never a token or other
  // credential (NDERCC-11 / DEC-RIC-001). `configurationEncrypted` above
  // remains unused (null) for GitHub; it is reserved for a future,
  // separately-decided encrypted-credential design.
  configurationJson       Json?     @map("configuration_json")
  lastVerifiedAt          DateTime? @db.Timestamptz(3) @map("last_verified_at")
  createdAt               DateTime  @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt               DateTime  @updatedAt @db.Timestamptz(3) @map("updated_at")

  // Restrict, not cascade: a Project with connections cannot be deleted
  // without first removing them, per NDERCC-5 scope (prefer blocking
  // destructive deletion over silently cascading it away).
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // Prevents duplicate rows for the same project/provider/external
  // repository while leaving multiple *distinct* repositories per project
  // fully possible — externalAccountId differs per repository, and
  // Postgres treats multiple NULLs in a unique index as non-conflicting
  // (NDERCC-11).
  @@unique([projectId, provider, externalAccountId], map: "integration_connections_project_provider_external_account_key")
  @@index([projectId])
  @@map("integration_connections")
}

// Project-owned strategic document registry entry (NDERCC-12 / DEC-RIC-002).
// Persistence and provenance only — no document body content lives on this
// model. Content snapshots were deferred by DEC-RIC-002 to NDERCC-13 and
// now exist as the separate immutable `DocumentSnapshot` aggregate below;
// this model still carries only the *current* synchronization pointer
// (revision/checksum/syncStatus/lastSyncedAt).
model DocumentSource {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId      String                 @map("project_id") @db.Uuid
  provider       DocumentProvider
  externalFileId String                 @map("external_file_id")
  documentType   DocumentType           @map("document_type")
  title          String
  url            String
  revision       String?
  approvalStatus DocumentApprovalStatus @default(DRAFT) @map("approval_status")
  syncStatus     DocumentSyncStatus     @default(PENDING) @map("sync_status")
  checksum       String?
  lastSyncedAt   DateTime?              @db.Timestamptz(3) @map("last_synced_at")
  // Non-secret provider metadata only — never document body content, a raw
  // provider response, or an HTTP header/credential (DEC-RIC-002). The
  // typed persistence surface in src/document-source.ts recursively rejects
  // credential-shaped keys before this column is ever written.
  metadataJson   Json?                  @map("metadata_json")
  createdAt      DateTime               @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt      DateTime               @updatedAt @db.Timestamptz(3) @map("updated_at")

  // Restrict, not cascade: strategic document provenance must never be
  // silently lost by deleting its owning Project (DEC-RIC-002).
  project   Project            @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  snapshots DocumentSnapshot[]
  requirements Requirement[]
  decisions Decision[]

  // The same provider file may be registered only once per project, but
  // independently in a different project — and a project may register more
  // than one source of the same documentType (approval policy, not a
  // uniqueness rule, decides which is authoritative), so no uniqueness on
  // (projectId, documentType) is added.
  @@unique([projectId, provider, externalFileId], map: "document_sources_project_provider_external_file_key")
  // Referenced by DocumentSnapshot's composite foreign key. `id` is
  // already unique on its own, so this adds no new restriction on
  // document_sources — it exists solely to give the snapshot table a
  // (source, project) pair to point at, which is what makes
  // "a snapshot's project always equals its source's project" a
  // database-enforced invariant rather than an application convention.
  @@unique([id, projectId], map: "document_sources_id_project_key")
  @@index([projectId])
  @@index([projectId, documentType])
  @@map("document_sources")
}

// Immutable, project-owned content snapshot of one strategic document at
// one provider version (NDERCC-13 / DEC-RIC-003).
//
// Append-only by design and by API: `packages/database/src/document-snapshot.ts`
// exposes create-and-read operations only — there is deliberately no
// update or delete function for this model anywhere in the package's
// public surface, and no `updatedAt` column, because a snapshot that could
// be edited after the fact would no longer be evidence of what the
// document actually said.
//
// `contentText` is the ONLY place in the schema authorized to hold
// document body content. Credentials, OAuth tokens, request/response
// headers and raw Google response payloads are never stored on this model
// — there is no column capable of carrying them.
model DocumentSnapshot {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId          String    @map("project_id") @db.Uuid
  documentSourceId   String    @map("document_source_id") @db.Uuid
  // Drive `files.version` as a string — DEC-RIC-003 rejects revision
  // history as the canonical identity because reader-only access cannot
  // read it.
  providerVersion    String    @map("provider_version")
  // Canonically normalized UTF-8 text (NFC, LF endings, BOM removed).
  contentText        String    @map("content_text")
  // Lowercase SHA-256 hex over `contentText` — must always match it.
  checksum           String
  providerModifiedAt DateTime? @db.Timestamptz(3) @map("provider_modified_at")
  syncedAt           DateTime  @db.Timestamptz(3) @map("synced_at")
  createdAt          DateTime  @default(now()) @db.Timestamptz(3) @map("created_at")

  // Restrict on both edges: an immutable strategic snapshot must never be
  // silently destroyed by deleting its project or its source row.
  //
  // The DocumentSource edge is a COMPOSITE key on (documentSourceId,
  // projectId) rather than the source id alone. That makes cross-project
  // contamination structurally impossible: a row claiming source S while
  // naming project P is rejected by PostgreSQL unless S genuinely belongs
  // to P — the isolation rule is enforced by the database, not only by the
  // transactional checks in src/document-snapshot.ts.
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  documentSource DocumentSource @relation(fields: [documentSourceId, projectId], references: [id, projectId], onDelete: Restrict, onUpdate: Cascade)

  requirements Requirement[]
  decisions Decision[]

  // Re-synchronizing an unchanged document must not append a duplicate
  // row: the same source at the same provider version with the same
  // content is one snapshot, and the sync path reuses it idempotently.
  // Checksum participates so that the pathological case of Drive reusing a
  // version number for changed content still records a distinct snapshot
  // rather than being silently swallowed.
  @@unique([documentSourceId, providerVersion, checksum], map: "document_snapshots_source_version_checksum_key")
  @@unique([id, projectId], map: "document_snapshots_id_project_key")
  @@index([projectId])
  @@index([documentSourceId])
  // Deterministic newest-snapshot lookup: `createdAt` alone can tie within
  // the same millisecond, so `id` is the stable tiebreaker and is part of
  // the index rather than an unindexed sort.
  @@index([documentSourceId, createdAt(sort: Desc), id(sort: Desc)], map: "document_snapshots_source_newest_idx")
  @@map("document_snapshots")
}

// Project-owned current projection of an explicitly extracted requirement.
// Constraints intentionally use this model with type = CONSTRAINT; there is
// no second aggregate for inferred/opaque constraints (DEC-RIC-004).
model Requirement {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId            String              @map("project_id") @db.Uuid
  code                 String
  title                String
  description          String
  type                 RequirementType
  priority             RequirementPriority @default(UNSPECIFIED)
  status               RequirementStatus   @default(ACTIVE)
  documentSourceId     String              @map("document_source_id") @db.Uuid
  sourceSnapshotId     String              @map("source_snapshot_id") @db.Uuid
  acceptanceCriteriaJson Json?             @map("acceptance_criteria_json")
  extractorVersion     String              @map("extractor_version")
  sourceLocatorJson    Json                @map("source_locator_json")
  createdAt            DateTime            @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt            DateTime            @updatedAt @db.Timestamptz(3) @map("updated_at")

  project        Project        @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  documentSource DocumentSource @relation(fields: [documentSourceId, projectId], references: [id, projectId], onDelete: Restrict, onUpdate: Cascade)
  sourceSnapshot DocumentSnapshot @relation(fields: [sourceSnapshotId, projectId], references: [id, projectId], onDelete: Restrict, onUpdate: Cascade)

  specLinks ImplementationSpecRequirement[]

  // Additive index introduced by NDERCC-23. `id` is already unique on its
  // own, so this changes no existing behaviour; it exists solely so an
  // implementation specification can reference a requirement through a
  // composite (id, project_id) foreign key, making a cross-project link
  // impossible at the database level rather than only in application code.
  // The NDERCC-16 migration itself is not edited.
  @@unique([id, projectId], map: "requirements_id_project_key")
  @@unique([projectId, code], map: "requirements_project_code_key")
  @@index([projectId, status], map: "requirements_project_status_idx")
  @@index([documentSourceId], map: "requirements_document_source_idx")
  @@index([sourceSnapshotId], map: "requirements_source_snapshot_idx")
  @@map("requirements")
}

// Project-owned current projection of an explicitly canonical DEC record.
// Optional fields remain null when the source did not state them; no prose is
// promoted to a decision by this model or its persistence surface.
model Decision {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId            String         @map("project_id") @db.Uuid
  code                 String
  title                String
  context              String?
  chosenDecision       String         @map("chosen_decision")
  consequences         String?
  status               DecisionStatus @default(PROPOSED)
  supersedesDecisionId String?        @map("supersedes_decision_id") @db.Uuid
  decidedAt            DateTime?      @db.Timestamptz(3) @map("decided_at")
  documentSourceId     String         @map("document_source_id") @db.Uuid
  sourceSnapshotId     String         @map("source_snapshot_id") @db.Uuid
  extractorVersion     String         @map("extractor_version")
  sourceLocatorJson    Json           @map("source_locator_json")
  createdAt            DateTime       @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt            DateTime       @updatedAt @db.Timestamptz(3) @map("updated_at")

  project        Project        @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  documentSource DocumentSource @relation(fields: [documentSourceId, projectId], references: [id, projectId], onDelete: Restrict, onUpdate: Cascade)
  sourceSnapshot DocumentSnapshot @relation(fields: [sourceSnapshotId, projectId], references: [id, projectId], onDelete: Restrict, onUpdate: Cascade)
  supersedes     Decision?      @relation("DecisionSupersession", fields: [supersedesDecisionId, projectId], references: [id, projectId], onDelete: Restrict, onUpdate: Cascade)
  supersededBy   Decision[]     @relation("DecisionSupersession")
  specLinks      ImplementationSpecDecision[]

  @@unique([id, projectId], map: "decisions_id_project_key")
  @@unique([projectId, code], map: "decisions_project_code_key")
  @@index([projectId, status], map: "decisions_project_status_idx")
  @@index([documentSourceId], map: "decisions_document_source_idx")
  @@index([sourceSnapshotId], map: "decisions_source_snapshot_idx")
  @@map("decisions")
}

// Project-owned planning container and the root of the operational backlog
// hierarchy (NDERCC-17 / DEC-RIC-005).
//
// `sequence` is explicit planning order — deliberately NOT createdAt order,
// so re-planning is an intentional data change rather than an artifact of
// insertion timing. Sequence alone is not an eligibility decision: P0-031
// owns actual next-item ranking and is not implemented here.
//
// No `roadmapItemId` exists. RoadmapItem persistence is deferred from this
// slice by DEC-RIC-005 §1 and must not be introduced without a later
// approved decision.
model Sprint {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId      String       @map("project_id") @db.Uuid
  // Immutable, human-readable local identity, unique per Project. Local
  // identity never depends on Jira being connected (DEC-RIC-005 §3).
  code           String
  title          String
  objective      String?
  status         SprintStatus @default(PLANNED)
  sequence       Int
  plannedStartAt DateTime?    @db.Timestamptz(3) @map("planned_start_at")
  plannedEndAt   DateTime?    @db.Timestamptz(3) @map("planned_end_at")
  startedAt      DateTime?    @db.Timestamptz(3) @map("started_at")
  completedAt    DateTime?    @db.Timestamptz(3) @map("completed_at")
  // Logical archival, separate from lifecycle status; permitted only for
  // terminal records (DEC-RIC-005 §12). No hard delete is exposed.
  archivedAt     DateTime?    @db.Timestamptz(3) @map("archived_at")
  createdAt      DateTime     @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3) @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  epics   Epic[]
  tasks   Task[]

  @@unique([projectId, code], map: "sprints_project_code_key")
  @@unique([projectId, sequence], map: "sprints_project_sequence_key")
  // Referenced by Epic's and Task's composite ownership foreign keys. `id`
  // is already unique alone, so this adds no new restriction on sprints —
  // it exists solely to give the child tables a (sprint, project) pair to
  // point at, which makes "a child's project always equals its sprint's
  // project" a database-enforced invariant rather than an application
  // convention.
  @@unique([id, projectId], map: "sprints_id_project_key")
  @@index([projectId, status], map: "sprints_project_status_idx")
  @@map("sprints")
}

// Project-owned grouping of Tasks inside exactly one Sprint.
//
// Optional Jira fields are provenance only: `externalKey` is mutable display
// metadata and is never the database identity, and no code in this
// repository calls a Jira API on behalf of this model. Synchronization is
// owned by P1-033/P1-034 (DEC-RIC-005 §4).
model Epic {
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId        String                   @map("project_id") @db.Uuid
  sprintId         String                   @map("sprint_id") @db.Uuid
  code             String
  title            String
  description      String?
  status           EpicStatus               @default(PLANNED)
  sequence         Int
  externalProvider BacklogExternalProvider? @map("external_provider")
  externalId       String?                  @map("external_id")
  externalKey      String?                  @map("external_key")
  externalUrl      String?                  @map("external_url")
  lastSyncedAt     DateTime?                @db.Timestamptz(3) @map("last_synced_at")
  startedAt        DateTime?                @db.Timestamptz(3) @map("started_at")
  completedAt      DateTime?                @db.Timestamptz(3) @map("completed_at")
  archivedAt       DateTime?                @db.Timestamptz(3) @map("archived_at")
  createdAt        DateTime                 @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt        DateTime                 @updatedAt @db.Timestamptz(3) @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  // Composite, not `sprintId` alone: PostgreSQL rejects an Epic claiming a
  // Sprint that belongs to a different Project, so cross-project contamination
  // is structurally impossible rather than merely checked in application code.
  sprint  Sprint  @relation(fields: [sprintId, projectId], references: [id, projectId], onDelete: Restrict, onUpdate: Cascade)
  tasks   Task[]

  @@unique([projectId, code], map: "epics_project_code_key")
  @@unique([sprintId, sequence], map: "epics_sprint_sequence_key")
  // Duplicate-safe external provenance when present. Postgres treats
  // multiple NULLs in a unique index as non-conflicting, so Epics without
  // Jira provenance never collide with each other.
  @@unique([projectId, externalProvider, externalId], map: "epics_project_external_key")
  // Target of Task's three-column ownership foreign key below — the pair
  // that makes "a Task's Epic is in the same Project AND the same Sprint"
  // database-enforced.
  @@unique([id, projectId, sprintId], map: "epics_id_project_sprint_key")
  @@index([projectId, status], map: "epics_project_status_idx")
  @@index([sprintId], map: "epics_sprint_idx")
  @@map("epics")
}

// The executable unit of the operational backlog. A Task always belongs to a
// Sprint and may optionally belong to an Epic within that same Sprint.
//
// `acceptanceCriteriaJson` is a deterministic ordered JSON array of non-empty
// strings (DEC-RIC-005 §9); arbitrary object schemas are deferred. An empty
// array is a legitimate non-ready planning record — NDERCC-17 does not claim
// such a Task is executable, because eligibility is not computed here at all.
model Task {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId              String                   @map("project_id") @db.Uuid
  sprintId               String                   @map("sprint_id") @db.Uuid
  epicId                 String?                  @map("epic_id") @db.Uuid
  code                   String
  type                   TaskType
  title                  String
  description            String?
  status                 TaskStatus               @default(TODO)
  priority               TaskPriority
  sequence               Int
  acceptanceCriteriaJson Json                     @default("[]") @map("acceptance_criteria_json")
  externalProvider       BacklogExternalProvider? @map("external_provider")
  externalId             String?                  @map("external_id")
  externalKey            String?                  @map("external_key")
  externalUrl            String?                  @map("external_url")
  lastSyncedAt           DateTime?                @db.Timestamptz(3) @map("last_synced_at")
  startedAt              DateTime?                @db.Timestamptz(3) @map("started_at")
  completedAt            DateTime?                @db.Timestamptz(3) @map("completed_at")
  archivedAt             DateTime?                @db.Timestamptz(3) @map("archived_at")
  createdAt              DateTime                 @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt              DateTime                 @updatedAt @db.Timestamptz(3) @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sprint  Sprint  @relation(fields: [sprintId, projectId], references: [id, projectId], onDelete: Restrict, onUpdate: Cascade)
  // Three columns, not one. Because `epicId` is nullable and PostgreSQL
  // foreign keys default to MATCH SIMPLE, the constraint is simply not
  // checked when `epicId` is NULL — which is exactly the wanted behaviour
  // for an optional Epic — while a Task that DOES name an Epic is forced to
  // agree with that Epic on both Project and Sprint.
  epic    Epic?   @relation(fields: [epicId, projectId, sprintId], references: [id, projectId, sprintId], onDelete: Restrict, onUpdate: Cascade)

  dependencies TaskDependency[] @relation("TaskDependsOnEdges")
  dependents   TaskDependency[] @relation("TaskPrerequisiteEdges")
  implementationSpecs ImplementationSpec[]

  @@unique([projectId, code], map: "tasks_project_code_key")
  @@unique([sprintId, sequence], map: "tasks_sprint_sequence_key")
  @@unique([projectId, externalProvider, externalId], map: "tasks_project_external_key")
  // Target of both TaskDependency edges, making same-project dependencies a
  // database guarantee.
  @@unique([id, projectId], map: "tasks_id_project_key")
  @@index([projectId, status], map: "tasks_project_status_idx")
  // Covers the deterministic planning-order listing (sprint -> status ->
  // priority -> sequence) that P0-031 will later read.
  @@index([sprintId, status, priority, sequence], map: "tasks_sprint_status_priority_sequence_idx")
  @@index([epicId], map: "tasks_epic_idx")
  @@map("tasks")
}

// A directed prerequisite edge: `taskId` requires `dependsOnTaskId`.
//
// Direction is explicit and is never inferred or auto-reversed. For later
// resolver semantics only a prerequisite in DONE satisfies the edge —
// CANCELLED, TODO, IN_PROGRESS and IN_REVIEW do not (DEC-RIC-005 §10).
// NDERCC-17 stores and validates that contract; it does not compute
// eligibility.
//
// Three separate protections, each at the lowest layer that can express it:
//   - same-project: both composite foreign keys below resolve through
//     (task id, project id), so an edge spanning two Projects cannot be
//     inserted at all;
//   - no duplicate edge: UNIQUE (task_id, depends_on_task_id);
//   - no self-dependency: CHECK `task_dependencies_no_self_check`
//     (task_id <> depends_on_task_id). Like `operators_singleton_check`,
//     this CHECK has no Prisma schema representation and lives only in
//     prisma/migrations/20260813120000_operational_backlog_model/migration.sql.
//     A future `prisma migrate dev` run touching this table must not let
//     Prisma's schema-diff drop it as unrepresented drift — review the
//     generated SQL before applying.
//
// Cycles are the one rule a relational constraint cannot express, so they
// are rejected transactionally in src/task-dependency.ts under the same
// project row lock that serializes every other backlog mutation.
model TaskDependency {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  taskId          String   @map("task_id") @db.Uuid
  dependsOnTaskId String   @map("depends_on_task_id") @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3) @map("created_at")

  project       Project @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  task          Task    @relation("TaskDependsOnEdges", fields: [taskId, projectId], references: [id, projectId], onDelete: Restrict, onUpdate: Cascade)
  dependsOnTask Task    @relation("TaskPrerequisiteEdges", fields: [dependsOnTaskId, projectId], references: [id, projectId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([taskId, dependsOnTaskId], map: "task_dependencies_pair_key")
  @@index([projectId], map: "task_dependencies_project_idx")
  @@index([taskId], map: "task_dependencies_task_idx")
  // Reverse lookup: "which Tasks are waiting on this one?"
  @@index([dependsOnTaskId], map: "task_dependencies_depends_on_idx")
  @@map("task_dependencies")
}

// The installation's single primary operator. `singleton` is always `true`.
// Two constraints together make a second operator row impossible at the
// database level, not just by application-level rule:
//   - UNIQUE on `singleton` blocks a second row with the SAME value
//     (e.g. two rows with singleton = true);
//   - CHECK `operators_singleton_check` (singleton = true) blocks
//     singleton = false entirely, closing the gap the UNIQUE index alone
//     leaves open (a row with singleton = false would not collide with
//     the true row under a plain UNIQUE index).
// The CHECK constraint has no Prisma schema representation: `@@check` is
// not a recognized attribute in this Prisma version (7.9.1) — confirmed by
// `prisma generate` rejecting it with P1012. It exists only in
// prisma/migrations/20260731140025_single_user_authentication/migration.sql.
// Any future `prisma migrate dev` run for this table must NOT let Prisma's
// schema-diff drop `operators_singleton_check` as unrepresented drift —
// review the generated SQL before applying.
// Provisioned only via the administrative bootstrap command
// (packages/database/src/cli/bootstrap-operator.ts); no application code
// creates or updates rows in this table.
model Operator {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  singleton    Boolean  @unique @default(true)
  username     String   @unique
  // Argon2id PHC-format hash string (algorithm + parameters + salt + hash).
  // Never a plaintext password.
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt    DateTime @updatedAt @db.Timestamptz(3) @map("updated_at")

  sessions AuthSession[]
  // Specifications this operator approved. Restrict on delete: an approval
  // must never lose the actor that granted it (NDERCC-23).
  approvedImplementationSpecs ImplementationSpec[]

  @@map("operators")
}

// A server-side session for the primary operator. The raw session token is
// never stored — only a SHA-256 digest, looked up on every request. Absolute
// 24-hour expiration via `expiresAt`; `revokedAt` marks logout or a
// password-change-triggered revocation.
model AuthSession {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operatorId   String    @map("operator_id") @db.Uuid
  // SHA-256 hex digest of the raw opaque session token.
  tokenDigest  String    @unique @map("token_digest")
  createdAt    DateTime  @default(now()) @db.Timestamptz(3) @map("created_at")
  expiresAt    DateTime  @db.Timestamptz(3) @map("expires_at")
  revokedAt    DateTime? @db.Timestamptz(3) @map("revoked_at")

  // Cascade, not restrict: sessions are ephemeral security artifacts owned
  // by the operator, unlike Project/IntegrationConnection business records —
  // there is no data-loss risk in removing them alongside their operator.
  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([operatorId])
  @@map("auth_sessions")
}

// ── Spec-Driven Development layer (NDERCC-23 / DEC-RIC-010 / P1-038) ─────────
//
// The mandatory specification layer RIC-E07A places between requirements and
// planning on one side and the Execution Contract on the other. A governed
// implementation specification is what an Execution Contract will later be
// derived FROM; nothing in this slice models, generates, validates or hashes
// a contract itself — that is P0-040 through P0-043 and does not exist yet.
//
// Identity has two independent halves:
//
//   - lineage identity `(project_id, code)` — e.g. RIC-SPEC-NDERCC-23-001,
//     the convention already used informally in Jira (DEC-RIC-006,
//     DEC-RIC-009), now made explicit;
//   - version identity `major.minor.patch`, stored both as three integer
//     columns (so ordering in SQL is a correct total order rather than
//     lexicographic) and as the canonical string actually written in
//     documents and Jira.
//
// A revision is a NEW ROW. Content is mutable only while DRAFT; once a row
// leaves DRAFT it is frozen for the rest of its life, and there is no update
// or delete operation for a non-DRAFT specification anywhere on the
// package's public surface. That is what makes an approval evidence of
// something.
//
// Two invariants have no Prisma schema representation and are written by
// hand in the NDERCC-23 migration SQL, the same situation as
// `operators_singleton_check` and `task_dependencies_no_self_check`. A
// future `prisma migrate dev` touching these tables must not let the schema
// differ drop them as unrepresented drift:
//
//   - `implementation_specs_task_approved_key` — a PARTIAL unique index
//     (`WHERE status = 'APPROVED'`) enforcing at most one approved
//     specification per Task, so contract derivation can never face two
//     competing authorities;
//   - `implementation_specs_supersedes_self_check` — a specification cannot
//     supersede itself.
model ImplementationSpec {
  id           String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId    String                   @map("project_id") @db.Uuid
  // The governed unit of work this specification authorises preparation for.
  // Required: a specification that governs nothing cannot gate anything.
  taskId       String                   @map("task_id") @db.Uuid
  // Immutable lineage identity, unique per Project. Trimmed and uppercased.
  code         String
  // Canonical `major.minor.patch` spelling, no `v` prefix.
  version      String
  versionMajor Int                      @map("version_major")
  versionMinor Int                      @map("version_minor")
  versionPatch Int                      @map("version_patch")
  status       ImplementationSpecStatus @default(DRAFT)

  // ── Content required by RIC-E07A ──
  // Always required: expected behaviour, scope, out of scope and verifiable
  // acceptance criteria.
  title                  String
  behavior               String
  scopeJson              Json @map("scope_json")
  nonGoalsJson           Json @map("non_goals_json")
  acceptanceCriteriaJson Json @map("acceptance_criteria_json")
  // RIC-E07A's "quando aplicável" fields. Always present as an ordered
  // array; an empty array states "none recorded", which is a different
  // claim from a missing field, so they default to `[]` rather than null.
  constraintsJson        Json @default("[]") @map("constraints_json")
  dependenciesJson       Json @default("[]") @map("dependencies_json")
  risksJson              Json @default("[]") @map("risks_json")
  interfacesJson         Json @default("[]") @map("interfaces_json")
  validationStrategyJson Json @default("[]") @map("validation_strategy_json")

  // SHA-256 of the canonical serialization of the content columns above,
  // recomputed by the persistence layer on every write and never trusted
  // from a caller — the DocumentSnapshot rule applied here. It identifies
  // WHAT the specification says; `(project_id, code, version)` identifies
  // WHICH specification it is. This is not an Execution Contract hash and
  // does not implement P0-043.
  contentHash  String @map("content_hash")
  // The @rick/domain rule-set version whose validation the content was
  // written against, so a later reader can tell which rules applied.
  rulesVersion String @map("rules_version")

  // Explicit supersession only: the successor names its predecessor. There
  // is deliberately no reverse `superseded_by` column — a second pointer
  // could disagree with this one. "What replaced this?" is the row whose
  // `supersedes_spec_id` is this id, and the unique index below keeps that
  // answer singular, so supersession forms a chain rather than a tree.
  supersedesSpecId String? @map("supersedes_spec_id") @db.Uuid

  // Approval is explicit and attributed, never inferred from state.
  approvedByOperatorId String?   @map("approved_by_operator_id") @db.Uuid
  approvedAt           DateTime? @db.Timestamptz(3) @map("approved_at")
  rejectedAt           DateTime? @db.Timestamptz(3) @map("rejected_at")
  rejectionReason      String?   @map("rejection_reason")
  supersededAt         DateTime? @db.Timestamptz(3) @map("superseded_at")
  createdAt            DateTime  @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt            DateTime  @updatedAt @db.Timestamptz(3) @map("updated_at")

  project    Project             @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  // Composite, so a specification can never govern a Task in another
  // Project.
  task       Task                @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Restrict, onUpdate: Cascade)
  approvedBy Operator?           @relation(fields: [approvedByOperatorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supersedes ImplementationSpec? @relation("ImplementationSpecSupersession", fields: [supersedesSpecId, projectId], references: [id, projectId], onDelete: Restrict, onUpdate: Cascade)
  supersededBy ImplementationSpec[] @relation("ImplementationSpecSupersession")

  requirementLinks ImplementationSpecRequirement[]
  decisionLinks    ImplementationSpecDecision[]

  // Target of the link tables' and the supersession relation's composite
  // foreign keys, making same-project traceability a database guarantee.
  @@unique([id, projectId], map: "implementation_specs_id_project_key")
  // Deterministic version identity.
  @@unique([projectId, code, version], map: "implementation_specs_project_code_version_key")
  // A predecessor can be superseded at most once.
  @@unique([supersedesSpecId], map: "implementation_specs_supersedes_key")
  @@index([projectId, status], map: "implementation_specs_project_status_idx")
  @@index([taskId, status], map: "implementation_specs_task_status_idx")
  // Covers "the current maximum version of this lineage", the read the
  // monotonic-version rule depends on.
  @@index([projectId, code, versionMajor, versionMinor, versionPatch], map: "implementation_specs_lineage_order_idx")
  @@map("implementation_specs")
}

// Traceability from an approved specification back to the strategic truth it
// was written against (RIC-006 §4 link-table convention).
//
// A link references a Requirement by foreign key and never copies its text,
// so no second source of truth for a requirement is created. Both composite
// foreign keys resolve through (id, project_id), so a link spanning two
// Projects cannot be inserted at all.
model ImplementationSpecRequirement {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  specId        String   @map("spec_id") @db.Uuid
  requirementId String   @map("requirement_id") @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(3) @map("created_at")

  project     Project            @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  spec        ImplementationSpec @relation(fields: [specId, projectId], references: [id, projectId], onDelete: Restrict, onUpdate: Cascade)
  requirement Requirement        @relation(fields: [requirementId, projectId], references: [id, projectId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([specId, requirementId], map: "implementation_spec_requirements_pair_key")
  @@index([projectId], map: "implementation_spec_requirements_project_idx")
  @@index([requirementId], map: "implementation_spec_requirements_requirement_idx")
  @@map("implementation_spec_requirements")
}

// The Decision half of the same traceability contract.
model ImplementationSpecDecision {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  specId     String   @map("spec_id") @db.Uuid
  decisionId String   @map("decision_id") @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(3) @map("created_at")

  project  Project            @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  spec     ImplementationSpec @relation(fields: [specId, projectId], references: [id, projectId], onDelete: Restrict, onUpdate: Cascade)
  decision Decision           @relation(fields: [decisionId, projectId], references: [id, projectId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([specId, decisionId], map: "implementation_spec_decisions_pair_key")
  @@index([projectId], map: "implementation_spec_decisions_project_idx")
  @@index([decisionId], map: "implementation_spec_decisions_decision_idx")
  @@map("implementation_spec_decisions")
}
