// Prisma schema for RICK Control Center
// Persistence foundation — sprint 0, NDERCC-4
// No domain models yet — a minimal HealthCheck record proves the migration pipeline.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Minimal table used only to prove the migration pipeline.
// Domain models (Project, User, Workspace) will be added in NDERCC-5.
model HealthCheck {
  id        Int      @id @default(autoincrement())
  checkedAt DateTime @default(now())

  @@map("health_checks")
}
