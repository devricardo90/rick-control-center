// Prisma schema for RICK Control Center
// Persistence foundation — sprint 0.
// NDERCC-5: first canonical domain slice — Project and IntegrationConnection.
//
// The NDERCC-4 `HealthCheck` proof-of-pipeline table is dropped by the
// NDERCC-5 migration (see prisma/migrations/*_initial_domain_model). The
// NDERCC-4 migration itself is left untouched — this is a new, additive
// migration, not an edit of migration history.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// RIC-006: initial, non-speculative project lifecycle. `archivedAt` carries
// the logical-archival timestamp; ARCHIVED mirrors it for direct filtering.
enum ProjectStatus {
  ACTIVE
  PAUSED
  ARCHIVED

  @@map("project_status")
}

// RIC-011 execution modes, reused as the project-level default policy.
enum AutonomyPolicy {
  SUPERVISED
  CONTROLLED_AUTONOMOUS

  @@map("autonomy_policy")
}

// The only two branch policies named in the Development Protocol
// (docs/12-development-protocol.md §7): dedicated branch per task (default),
// or direct commits where policy explicitly allows it.
enum BranchPolicy {
  BRANCH_PER_TASK
  DIRECT_COMMIT

  @@map("branch_policy")
}

// Required initial providers per NDERCC-5 scope.
enum IntegrationProvider {
  GITHUB
  JIRA
  GOOGLE_DRIVE
  AGENT_RUNTIME

  @@map("integration_provider")
}

// Verification lifecycle for an IntegrationConnection. PENDING until first
// verified; ERROR/DISCONNECTED are distinct so a failed check is
// distinguishable from a deliberate disconnect.
enum IntegrationConnectionStatus {
  PENDING
  CONNECTED
  ERROR
  DISCONNECTED

  @@map("integration_connection_status")
}

// Root isolation aggregate. Every operational entity belongs to a Project.
model Project {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                 String    @unique
  name                String
  description         String?
  status              ProjectStatus  @default(ACTIVE)
  autonomyPolicy      AutonomyPolicy @default(CONTROLLED_AUTONOMOUS) @map("autonomy_policy")
  defaultBranchPolicy BranchPolicy   @default(BRANCH_PER_TASK) @map("default_branch_policy")
  workspacePath       String?   @map("workspace_path")
  createdAt           DateTime  @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3) @map("updated_at")
  archivedAt          DateTime? @db.Timestamptz(3) @map("archived_at")

  integrationConnections IntegrationConnection[]

  @@map("projects")
}

// First project-owned integration entity. `configurationEncrypted` is an
// opaque, already-encrypted payload — this package never encrypts, decrypts,
// or inspects it, and no plaintext credential field exists on this model.
model IntegrationConnection {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId               String    @map("project_id") @db.Uuid
  provider                IntegrationProvider
  displayName             String    @map("display_name")
  status                  IntegrationConnectionStatus @default(PENDING)
  externalAccountId       String?   @map("external_account_id")
  configurationEncrypted  String?   @map("configuration_encrypted")
  lastVerifiedAt          DateTime? @db.Timestamptz(3) @map("last_verified_at")
  createdAt               DateTime  @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt               DateTime  @updatedAt @db.Timestamptz(3) @map("updated_at")

  // Restrict, not cascade: a Project with connections cannot be deleted
  // without first removing them, per NDERCC-5 scope (prefer blocking
  // destructive deletion over silently cascading it away).
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([projectId])
  @@map("integration_connections")
}

// The installation's single primary operator. `singleton` is always `true`.
// Two constraints together make a second operator row impossible at the
// database level, not just by application-level rule:
//   - UNIQUE on `singleton` blocks a second row with the SAME value
//     (e.g. two rows with singleton = true);
//   - CHECK `operators_singleton_check` (singleton = true) blocks
//     singleton = false entirely, closing the gap the UNIQUE index alone
//     leaves open (a row with singleton = false would not collide with
//     the true row under a plain UNIQUE index).
// The CHECK constraint has no Prisma schema representation: `@@check` is
// not a recognized attribute in this Prisma version (7.9.1) — confirmed by
// `prisma generate` rejecting it with P1012. It exists only in
// prisma/migrations/20260731140025_single_user_authentication/migration.sql.
// Any future `prisma migrate dev` run for this table must NOT let Prisma's
// schema-diff drop `operators_singleton_check` as unrepresented drift —
// review the generated SQL before applying.
// Provisioned only via the administrative bootstrap command
// (packages/database/src/cli/bootstrap-operator.ts); no application code
// creates or updates rows in this table.
model Operator {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  singleton    Boolean  @unique @default(true)
  username     String   @unique
  // Argon2id PHC-format hash string (algorithm + parameters + salt + hash).
  // Never a plaintext password.
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt    DateTime @updatedAt @db.Timestamptz(3) @map("updated_at")

  sessions AuthSession[]

  @@map("operators")
}

// A server-side session for the primary operator. The raw session token is
// never stored — only a SHA-256 digest, looked up on every request. Absolute
// 24-hour expiration via `expiresAt`; `revokedAt` marks logout or a
// password-change-triggered revocation.
model AuthSession {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operatorId   String    @map("operator_id") @db.Uuid
  // SHA-256 hex digest of the raw opaque session token.
  tokenDigest  String    @unique @map("token_digest")
  createdAt    DateTime  @default(now()) @db.Timestamptz(3) @map("created_at")
  expiresAt    DateTime  @db.Timestamptz(3) @map("expires_at")
  revokedAt    DateTime? @db.Timestamptz(3) @map("revoked_at")

  // Cascade, not restrict: sessions are ephemeral security artifacts owned
  // by the operator, unlike Project/IntegrationConnection business records —
  // there is no data-loss risk in removing them alongside their operator.
  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([operatorId])
  @@map("auth_sessions")
}
