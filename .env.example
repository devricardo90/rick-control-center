# RICK Control Center — Environment Variables
# Copy this file to .env and fill in values. Never commit .env.

# ── Application ──────────────────────────────────────────────────────────────
NUXT_PUBLIC_APP_NAME="RICK Control Center"
NUXT_PUBLIC_APP_VERSION="0.1.0"

# ── Database ──────────────────────────────────────────────────────────────────
