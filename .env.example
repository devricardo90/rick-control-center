# RICK Control Center — Environment Variables
# Copy this file to .env and fill in values. Never commit .env.

# ── Application ──────────────────────────────────────────────────────────────
NUXT_PUBLIC_APP_NAME="RICK Control Center"
NUXT_PUBLIC_APP_VERSION="0.1.0"

# ── Database ──────────────────────────────────────────────────────────────────
# Matches the local Postgres started via `docker compose up -d` (docker-compose.yml).
# These are non-secret local development placeholders only — never use in production.
DATABASE_URL="postgresql://rick:rick@localhost:5432/rick_dev"

# ── Session / Auth ──────────────────────────────────────────────────────────
# Implemented (NDERCC-6): session tokens are opaque random values, stored
# server-side only as a SHA-256 digest — not signed, so no secret is
# required. NUXT_SESSION_SECRET is not read by any code path; kept here
# only as a placeholder should a future signed-token strategy need it.
# NUXT_SESSION_SECRET=

# ── Integrations (future) ─────────────────────────────────────────────────────
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# JIRA_CLIENT_ID=
# JIRA_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Agent Runtime (future) ────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=
